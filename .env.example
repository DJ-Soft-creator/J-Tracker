# ─── Application ──────────────────────────────────────
SECRET_KEY=<generate-a-strong-random-key>
# Deployment stage. Set to dev only for an HTTP-only local DEV environment.
ENVIRONMENT=prod

# Multiuser: users are stored in the docker volume at /app/data/users.json
# (auto-created on first start). AUTH_USER/AUTH_PASS below are ONLY used for a
# one-time migration when users.json is empty — the password is stored in
# PLAINTEXT initially. Please change it via Settings → Password after first
# login. Once users exist, AUTH_USER/AUTH_PASS are ignored.
AUTH_USER=admin
AUTH_PASS=<your-secure-password>

# Optional static admin token for the user-creation endpoint
# POST /api/admin/users (header X-Admin-Token, JSON {username,password}).
# If left empty, the endpoint is disabled (returns 404).
# ADMIN_TOKEN=<generate-a-strong-random-token>

# ─── Server ───────────────────────────────────
PORT=4097
TZ=Europe/Berlin
# Host directory mounted by docker-compose.yml at /app/data.
JOURNAL_DATA_DIR=/docker-storage/my_Journal_data/data/journals/
# Container-internal path; keep /app/data when using docker-compose.yml.
DATA_DIR=/app/data
SCHEDULER_HOUR=6
# Poll interval of the hashtag backfill sidecar (each user picks their own hour).
TAGGING_POLL_SECONDS=300

# PostgreSQL is internal to Compose; do not publish a database port.
# Set JOURNL_DB_ENABLED=true only after `python /app/scripts/db-migrate.py upgrade`
# completed successfully in DEV. Keep this password private and distinct per environment.
JOURNL_DB_ENABLED=false
POSTGRES_USER=journl
POSTGRES_DB=journl
POSTGRES_PASSWORD=<generate-a-strong-database-password>
# Host directory for runtime locks; it must be outside JOURNAL_DATA_DIR, owned
# by the app UID and created before explicitly enabling the database profile.
JOURNL_DB_LOCK_DIR=/docker-storage/my_Journal_lock_data

# Private CPU Whisper service (enable with docker compose --profile whisper up -d --build)
WHISPER_API_KEY=<generate-a-strong-random-token>
WHISPER_MODEL=base
# Auswählbare Qualitätsstufen in der Oberfläche (Komma-getrennt)
WHISPER_MODELS=tiny,base,small,medium
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_PORT=8090
WHISPER_SCHEDULE_HOUR=11
WHISPER_LANGUAGE=de

# ─── Local LLM IP (for lm_studio provider/templates) ──────────────
locale_LLM_IP=<your-llm-host-ip>

# ─── AI Templates (optional, overrides config.json) ────────────────
# Format: AI_TEMPLATE_<INDEX>_<KEY>=<value>
# Example for template index 0:
# AI_TEMPLATE_0_API_URL=http://IP:1234/v1/chat/completions
# AI_TEMPLATE_0_MODEL=qwen3.6-35b-a3b
# AI_TEMPLATE_0_MAX_TOKENS=5000

# ─── AI Providers (new two-stage config) ────────────────────────────
# Format: AI_PROVIDER_<INDEX>_<KEY>=<value>  (overrides config.json ai_providers[])
# API key auto-linking: provider "id" → AI_KEY_<UPPER_ID>
# Example for provider with id "lm_studio":
# AI_KEY_LM_STUDIO=your-api-key-here
# AI_PROVIDER_0_API_URL=http://IP:1234/v1/chat/completions
# AI_PROVIDER_0_MODEL=qwen3.6-35b-a3b

# ─── Journal-Analyse: Zeitlimits je Modellaufruf (Sekunden) ────────
# Die Analyse streamt. TIMEOUT ist die Leerlaufgrenze (so lange darf das
# Modell gar nichts schicken, z.B. beim Einlesen des Prompts), Standard 900,
# Werte < 30 werden ignoriert. MAX_DURATION begrenzt die Gesamtdauer eines
# Aufrufs, Standard 3600, nie kuerzer als TIMEOUT.
# JOURNAL_ANALYSIS_AI_TIMEOUT=900
# JOURNAL_ANALYSIS_AI_MAX_DURATION=3600

# ─── AI Functions (optional, overrides config.json ai_functions[]) ──
# Format: AI_FUNCTION_<INDEX>_<KEY>=<value>
# AI_FUNCTION_0_SYSTEM_PROMPT=Du bist ein Lektor...
